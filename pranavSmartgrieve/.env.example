# ==========================================
# SERVER & APP CONFIGURATION
# ==========================================
PORT=3000
CLIENT_URL=http://localhost:5173

# ==========================================
# DATABASE (MongoDB)
# ==========================================
MONGODB_URI=mongodb://localhost:27017/smartgrieve

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# REDIS QUEUE (BullMQ / ioredis)
# ==========================================
REDIS_URL=redis://127.0.0.1:6379

# ==========================================
# AI SERVICES (Google Gemini, Grok/xAI, Google TTS)
# ==========================================
# Gemini (for media/vision/audio transcription)
GEMINI_API_KEY=your_gemini_api_key

# Grok / xAI (for text classification via LangChain)
AI_HARNESS=langchain
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3-mini

# Google TTS (Text-to-Speech)
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key

# ==========================================
# CLOUDINARY (Media Storage)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# META WHATSAPP CLOUD API
# ==========================================
WHATSAPP_TOKEN=your_meta_whatsapp_access_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
VERSION=v22.0
VERIFY_TOKEN=your_webhook_verify_token

# ==========================================
# EMAIL NOTIFICATIONS (Nodemailer / Gmail)
# ==========================================
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
OAUTH_EMAIL=your_oauth_email
